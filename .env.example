# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE FOR MARIADB BACKUP TO S3
# =============================================================================
#
# 🚨 SECURITY WARNING: This file contains sensitive credentials and configuration
# 🚨 Never commit this file to version control
# 🚨 Never share this file without proper authorization
# 🚨 Set restrictive file permissions: chmod 600 .env
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#   nano .env
#
# This file contains all required environment variables with examples and documentation
# for setting up MariaDB and MongoDB backups with the mariadb-backup-s3 tool.

# =============================================================================
# DATABASE CONFIGURATION (DB__* - PREFERRED)
# =============================================================================
#
# Generic database variables for both engines. DB__* takes precedence over the
# legacy MARIADB__* variables below (legacy names still work when the DB__*
# variable is not set).
# Optional DB__* entries are commented out so an empty value cannot shadow a
# populated legacy MARIADB__* value; uncomment them to override.
# Engine-dependent defaults: mariadb -> port 3306, method mariadb-backup,
# client binary mariadb, restore binary unused (extract-only);
# mongodb -> port 27017, method mongodump, backup binary mongodump,
# restore binary mongorestore, client binary empty.
# When switching to mongodb: set DB__ENGINE=mongodb, adjust the connection
# values below (or comment them out to use engine defaults: localhost/27017/
# empty), and comment out the legacy MARIADB__* connection values.

# Database Engine
# Purpose: Select the database engine
# Format: string ("mariadb" or "mongodb")
# Default: mariadb
# Required: No
# Notes:
#   - mariadb: physical (mariadb-backup) or logical (mariadb-dump) backup
#   - mongodb: logical mongodump backup (requires MongoDB Database Tools)
DB__ENGINE=mariadb

# Database Host
# Purpose: Hostname or IP address of the database server
# Format: string (hostname or IP address)
# Default: localhost
# Required: Yes
# Legacy fallback: MARIADB__HOST
# Examples:
#   - localhost (local database)
#   - db.example.com (remote database)
DB__HOST=localhost

# Database Port
# Purpose: Port number for the database connection
# Format: integer (1-65535)
# Default: engine-dependent (3306 for mariadb, 27017 for mongodb)
# Required: No
# Legacy fallback: MARIADB__PORT
DB__PORT=3306

# Database Username
# Purpose: Username for authenticating with the database
# Format: string (alphanumeric + underscore)
# Default: root (mariadb); empty (mongodb, unless a URI user is set)
# Required: No
# Legacy fallback: MARIADB__USER
# Security: Use a dedicated backup user with minimal privileges
DB__USER=root

# Database Password
# Purpose: Password for authenticating with the database
# Format: string (minimum 8 characters recommended)
# Required: Yes (if the server requires authentication)
# Legacy fallback: MARIADB__PASSWORD
# Security: Use a strong, unique password. Consider using a dedicated backup user.
DB__PASSWORD=secure_password

# Backup Method
# Purpose: Select the backup method
# Format: string ("mariadb-backup", "mariadb-dump", or "mongodump")
# Default: derived from DB__ENGINE (mariadb -> mariadb-backup, mongodb -> mongodump)
# Required: No
# Legacy fallback: MARIADB__BACKUP_METHOD
# Notes:
#   - mariadb-backup: hot physical backup (mariadb engine only)
#   - mariadb-dump: logical SQL dump, per-database .sql files (mariadb engine only)
#   - mongodump: logical BSON dump of all databases (mongodb engine only)
# DB__BACKUP_METHOD=

# Backup Binary
# Purpose: Path to the backup binary
# Format: string (binary name or full path)
# Default: auto-derived from engine and method (mariadb-backup, mariadb-dump, or mongodump)
# Required: No
# Legacy fallback: MARIADB__BACKUP_BINARY
# DB__BACKUP_BINARY=

# Client Binary
# Purpose: Path to the client binary used for database discovery
# Format: string (binary name or full path)
# Default: mariadb (mariadb engine); empty (mongodb engine)
# Required: No (only used by the mariadb-dump logical backup)
# Legacy fallback: MARIADB__CLIENT_BINARY
# DB__CLIENT_BINARY=mariadb

# Backup Options
# Purpose: Additional options passed to the backup tool (sanitized)
# Format: string (space-separated options)
# Default: (empty)
# Required: No
# Legacy fallback: MARIADB__BACKUP_OPTIONS
# Examples:
#   --single-transaction (mariadb-dump, InnoDB only)
#   --oplog (mongodump, replica sets; point-in-time consistency)
# DB__BACKUP_OPTIONS=

# Restore Binary
# Purpose: Path to the restore binary invoked for the mongodb engine
# Format: string (binary name or full path)
# Default: mongorestore (mongodb engine); unused (mariadb restore is extract-only)
# Required: No (validated only for mongodb restore, where it must be in PATH)
# Notes: No legacy MARIADB__ equivalent
# DB__RESTORE_BINARY=mongorestore

# Restore Options
# Purpose: Additional options passed to the restore tool (mongodb engine, sanitized)
# Format: string (space-separated options)
# Default: (empty)
# Required: No
# Notes: No legacy MARIADB__ equivalent
# Examples:
#   --drop --oplogReplay (mongorestore)
# DB__RESTORE_OPTIONS=

# =============================================================================
# MONGODB CONFIGURATION (MONGODB__*)
# =============================================================================
#
# Only used when DB__ENGINE=mongodb. Connection settings are passed to
# mongodump/mongorestore; credentials are written to a temporary config file
# outside the backup directory instead of the command line.

# MongoDB Connection URI
# Purpose: Full MongoDB connection URI; replaces host/port/user when set
# Format: mongodb:// or mongodb+srv:// URI
# Default: (empty - use host/port/user)
# Required: No
# Examples:
#   - mongodb://mongo.example.com:27017
#   - mongodb://user:pass@mongo.example.com:27017/?replicaSet=rs0
MONGODB__URI=

# MongoDB Authentication Source
# Purpose: Authentication source database for MongoDB credentials
# Format: string (database name)
# Default: admin (applied automatically when the engine is mongodb)
# Required: No
# Notes: Skipped when the URI already carries an authSource parameter;
#        only passed when credentials (username or URI user) exist
MONGODB__AUTH_SOURCE=

# MongoDB TLS
# Purpose: Enable TLS for the MongoDB connection
# Format: boolean (true/false)
# Default: false
# Required: No
MONGODB__TLS=false

# MongoDB TLS CA File
# Purpose: Path to the CA certificate file used to verify the server (PEM)
# Format: file path
# Default: (empty)
# Required: No (only when TLS server verification is needed)
MONGODB__TLS_CA_FILE=

# MongoDB TLS Certificate Key File
# Purpose: Path to the client certificate and key file for mutual TLS (PEM)
# Format: file path
# Default: (empty)
# Required: No (only for mutual TLS)
MONGODB__TLS_CERTIFICATE_KEY_FILE=

# =============================================================================
# MARIADB DATABASE CONFIGURATION (LEGACY FALLBACK)
# =============================================================================
#
# Legacy variables: still supported when the matching DB__* variable above is
# not set. Prefer the DB__* block for new setups.

# MariaDB Host
# Purpose: Hostname or IP address of the MariaDB server
# Format: string (hostname or IP address)
# Default: localhost
# Required: Yes
# Security: Consider using private IP addresses for production
# Examples:
#   - localhost (local database)
#   - db.example.com (remote database)
#   - 192.168.1.100 (IP address)
MARIADB__HOST=localhost

# MariaDB Port
# Purpose: Port number for MariaDB connection
# Format: integer (1-65535)
# Default: 3306
# Required: Yes
# Examples:
#   - 3306 (default MariaDB port)
#   - 3307 (custom port)
MARIADB__PORT=3306

# MariaDB Username
# Purpose: Username for authenticating with MariaDB
# Format: string (alphanumeric + underscore)
# Default: root
# Required: Yes
# Security: Use a dedicated backup user with minimal privileges
# Examples:
#   - root (default admin user)
#   - backup_user (dedicated backup user)
#   - mariabackup (service account)
MARIADB__USER=root

# MariaDB Password
# Purpose: Password for authenticating with MariaDB
# Format: string (minimum 8 characters recommended)
# Required: Yes
# Security: Use a strong, unique password. Consider using a dedicated backup user.
# Examples:
#   - secure_password_123 (weak example - use stronger)
#   - J8$kL9@mN2&qP5!w (strong example)
MARIADB__PASSWORD=secure_password

# MariaDB Backup Options
# Purpose: Additional options for the mariabackup command
# Format: string (space-separated options)
# Default: (empty)
# Required: No
# Security: Only use options from trusted sources
# Examples:
#   --skip-ssl (skip SSL verification - not recommended for production)
#   --slave-info (for replication setups)
MARIADB__BACKUP_OPTIONS=

# Backup Method
# Purpose: Select backup method - physical (mariadb-backup) or logical (mariadb-dump)
# Format: string ("mariadb-backup" or "mariadb-dump")
# Default: mariadb-backup
# Required: No
# Notes:
#   - mariadb-backup: Hot physical backup (requires mariadb-backup binary)
#   - mariadb-dump: Logical SQL dump (requires mariadb-dump binary)
#     Produces per-database .sql files. Restore via: mysql < file.sql
MARIADB__BACKUP_METHOD=mariadb-backup

# MariaDB Backup Binary
# Purpose: Path to the backup binary
# Format: string (binary name or full path)
# Default: auto-derived from MARIADB__BACKUP_METHOD
# Required: No
# Notes:
#   - Auto-derived: mariadb-backup for physical, mariadb-dump for logical
#   - Override only if binary is in a non-standard location
MARIADB__BACKUP_BINARY=

# MariaDB Client Binary
# Purpose: Path to the mariadb client binary (used to list databases for logical backup)
# Format: string (binary name or full path)
# Default: mariadb
# Required: No
# Notes:
#   - Only used when MARIADB__BACKUP_METHOD=mariadb-dump
#   - Override only if mariadb client is in a non-standard location
MARIADB__CLIENT_BINARY=mariadb

# =============================================================================
# 📦 STORAGE CONFIGURATION
# =============================================================================

# Storage URL
# Purpose: URL for storage destination (supports s3://, file://, ftp://)
# Format: URL string
# Required: Yes
# Examples:
#   - s3://my-bucket/backups?endpoint=https://s3.custom.com
#   - s3://my-bucket/backups?endpoint=https://s3.custom.com&part-size=20971520
#   - file:///var/backups
#   - ftp://user:password@backup.example.com:21/path
# S3 Query Parameters:
#   - endpoint: S3 endpoint URL
#   - s3-force-path-style: Set to "true" to use path-style URLs
#   - part-size: Multipart upload part size in bytes (default: 10485760, min: 5242880)
#     Tip: Increase for large files or slow networks to reduce API calls and improve reliability
STORAGE__URL=

# =============================================================================
# 🔄 BACKUP RETENTION CONFIGURATION
# =============================================================================

# Maximum Backup Count
# Purpose: Maximum number of backups to retain (0 = unlimited)
# Format: integer (0-9999)
# Default: 0 (unlimited)
# Required: No
# Security: Consider retention policies for compliance requirements
# Examples:
#   - 7 (keep last 7 backups)
#   - 30 (keep last 30 backups)
#   - 0 (unlimited retention - use with caution)
#   - 365 (keep 365 backups)
BACKUP__LIMITS__MAX_COUNT=0


# =============================================================================
# 🚀 AWS S3 CONFIGURATION
# =============================================================================

# AWS Region
# Purpose: AWS region for S3 storage
# Format: string
# Example: us-east-1
AWS__REGION=

# AWS Access Key ID
# Purpose: AWS access key ID for S3 storage
# Format: string
# Example: AKIAIOSFODNN7EXAMPLE
AWS__ACCESS_KEY_ID=

# AWS Secret Access Key
# Purpose: AWS secret access key for S3 storage
# Format: string
# Example: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS__SECRET_ACCESS_KEY=

# =============================================================================
# 🔐 ENCRYPTION CONFIGURATION
# =============================================================================

# Encryption Key
# Purpose: AES256-GCM encryption key for backup files
# Format: string (base64 encoded)
# Required: No
# Security:
#   - Never commit this key to version control
#   - Store in secure environment variables or secret management systems
#   - Use cryptographically secure random generation methods
#   - Consider rotating keys quarterly for production environments
# Generation:
#   - openssl rand -base64 32
#   - head -c 32 /dev/urandom | base64
# Example: Av2cfWJ3enCHTyzPdzowfAXshvJtbEsvwgPjV46wnjc=
ENCRYPTION__KEY=

# =============================================================================
# ⏰ SCHEDULER CONFIGURATION
# =============================================================================

# Scheduler Config Path
# Purpose: Path to the scheduler YAML configuration file
# Format: file path
# Required: Yes (for scheduler command)
# Example: /etc/mariadb-backup-s3/scheduler.yaml
SCHEDULER__CONFIG=

# Scheduler State File
# Purpose: Path to the scheduler state file (JSON)
# Format: file path
# Default: /tmp/mariadb-scheduler-state.json
# Required: No
# Security: Ensure the directory has restricted permissions (chmod 700)
# Example: /var/lib/mariadb-backup-s3/state.json
SCHEDULER__STATE_FILE=
