# MariaDB username for database authentication
MARIADB__USER=root

# MariaDB password for database authentication
MARIADB__PASSWORD=000000

# MariaDB host for database connection
MARIADB__HOST=localhost

# MariaDB port for database connection
MARIADB__PORT=3306

# URL for storage service, including bucket/container name and endpoint
# Choose one of the following storage backends:

# S3 Storage (AWS S3, MinIO, DigitalOcean Spaces, etc.)
# STORAGE__URL=s3://bucket-name/prefix?endpoint=http://127.0.0.1:9000&force_path_style=true

# Google Cloud Storage (GCS)
# STORAGE__URL=gcs://bucket-name/prefix?project=your-project-id

# Azure Blob Storage
# STORAGE__URL=azure://account-name/container-name/path?sas=your-sas-token

# FTP/SFTP Storage
# STORAGE__URL=ftp://username:password@host:port/path

# Filesystem Storage
# STORAGE__URL=file:///absolute/path/to/backup/directory

# Number of backups to retain (0 = keep all)
BACKUP__LIMITS__MAX_COUNT=30

# AWS Access Key for S3 storage (required if using S3)
# AWS_ACCESS_KEY=000000000000000000000

# AWS Secret Key for S3 storage (required if using S3)
# AWS_SECRET_KEY=000000000000000000000

# AWS region for S3 storage (required if using S3)
# AWS_REGION=us-east-1

# Google Application Credentials for GCS (required if using GCS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json