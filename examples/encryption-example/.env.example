# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE FOR ENCRYPTED MARIADB BACKUP TO S3
# =============================================================================
#
# 🚨 SECURITY WARNING: This file contains sensitive credentials and configuration
# 🚨 Never commit this file to version control
# 🚨 Never share this file without proper authorization
# 🚨 Set restrictive file permissions: chmod 600 .env
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#   nano .env
#
# This file contains all required environment variables with examples and documentation
# for setting up encrypted MariaDB backups with the mariadb-backup-s3 tool.

# =============================================================================
# 📋 MARIADB DATABASE CONFIGURATION
# =============================================================================

# MariaDB Host
# Purpose: Hostname or IP address of the MariaDB server
# Format: string (hostname or IP address)
# Default: localhost
# Required: Yes
# Security: Consider using private IP addresses for production
# Examples:
#   - localhost (local database)
#   - db.example.com (remote database)
#   - 192.168.1.100 (IP address)
MARIADB__HOST=localhost

# MariaDB Port
# Purpose: Port number for MariaDB connection
# Format: integer (1-65535)
# Default: 3306
# Required: Yes
# Examples:
#   - 3306 (default MariaDB port)
#   - 3307 (custom port)
MARIADB__PORT=3306

# MariaDB Username
# Purpose: Username for authenticating with MariaDB
# Format: string (alphanumeric + underscore)
# Default: root
# Required: Yes
# Security: Use a dedicated backup user with minimal privileges
# Examples:
#   - root (default admin user)
#   - backup_user (dedicated backup user)
#   - mariabackup (service account)
MARIADB__USER=root

# MariaDB Password
# Purpose: Password for authenticating with MariaDB
# Format: string (minimum 8 characters recommended)
# Required: Yes
# Security: Use a strong, unique password. Consider using a dedicated backup user.
# Examples:
#   - secure_password_123 (weak example - use stronger)
#   - J8$kL9@mN2&qP5!w (strong example)
MARIADB__PASSWORD=secure_password

# =============================================================================
# 📦 STORAGE CONFIGURATION
# =============================================================================

# Storage URL
# Purpose: URL for storage destination (supports s3://, file://, ftp://)
# Format: URL string
# Required: Yes
# Examples:
#   - s3://my-bucket/backups?endpoint=https://s3.custom.com
#   - s3://my-bucket/backups?endpoint=https://s3.custom.com&part-size=20971520
#   - file:///var/backups
#   - ftp://user:password@backup.example.com:21/path
# S3 Query Parameters:
#   - endpoint: S3 endpoint URL
#   - s3-force-path-style: Set to "true" to use path-style URLs
#   - part-size: Multipart upload part size in bytes (default: 10485760, min: 5242880)
STORAGE__URL=

# =============================================================================
# 🔐 ENCRYPTION CONFIGURATION
# =============================================================================

# Encryption Key
# Purpose: AES256-GCM encryption key for backup files
# Format: string (base64 encoded)
# Required: Yes (for this example)
# Security: 🔒 CRITICAL - This is the most important security setting
#
# SECURITY REQUIREMENTS:
#   - Never commit this key to version control
#   - Store in secure environment variables or secret management systems
#   - Use cryptographically secure random generation methods
#   - Consider rotating keys quarterly for production environments
#   - Store backup keys separately from production keys
#   - Use different keys for different environments (dev, staging, prod)
#   - Document key rotation procedures and recovery processes
#
# KEY GENERATION METHODS:
#   - openssl rand -base64 32 (recommended)
#   - head -c 32 /dev/urandom | base64
#   - python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# KEY VALIDATION:
#   - echo "$ENCRYPTION__KEY" | base64 -d > /dev/null (should succeed)
#
# STORAGE RECOMMENDATIONS:
#   - Use secret management tools (AWS KMS, HashiCorp Vault, Azure Key Vault)
#   - Store keys in secure, offline locations for disaster recovery
#   - Consider using hardware security modules (HSM) for high-security environments
#
# WARNING: If you lose this key, your backups will be permanently unrecoverable!
# There is no way to decrypt backups without the correct encryption key.
#
# Example: Av2cfWJ3enCHTyzPdzowfAXshvJtbEsvwgPjV46wnjc=
ENCRYPTION__KEY=BASE64_ENCODED_KEY

# =============================================================================
# 📧 NOTIFICATION CONFIGURATION
# =============================================================================

# Email Notification
# Purpose: Email address for backup failure notifications
# Format: email address (user@domain.com)
# Required: No (optional)
# Security: Consider using dedicated monitoring email addresses
# Examples:
#   - admin@example.com (primary admin)
#   - backups-alerts@company.com (dedicated alerts)
#   - monitoring-team@company.com (team monitoring)
#   - (empty to disable email notifications)
#
# REQUIREMENTS:
#   - System must have working mail command (mailutils, postfix, etc.)
#   - SMTP server must be properly configured
#   - Consider using dedicated notification services for production
NOTIFY_EMAIL=

# =============================================================================
# 📝 LOGGING CONFIGURATION
# =============================================================================

# Log File Path
# Purpose: Path to main backup log file
# Format: file path (absolute or relative)
# Default: /var/log/mariadb-backup-encryption.log
# Required: No (optional)
# Security: Ensure log directory has appropriate permissions
# Examples:
#   - /var/log/mariadb-backup-encryption.log (system log directory)
#   - /home/backup/logs/backup.log (user directory)
#   - ./logs/backup.log (relative to script directory)
#
# PERMISSIONS:
#   - Log directory: 755 (drwxr-xr-x)
#   - Log file: 644 (-rw-r--r--)
#   - Ensure backup user has write access to log directory
LOG_FILE=/var/log/mariadb-backup-encryption.log

# Error Log File Path
# Purpose: Path to backup error log file (separate from main log)
# Format: file path (absolute or relative)
# Default: /var/log/mariadb-backup-encryption-error.log
# Required: No (optional)
# Security: Keep error logs separate for easier monitoring
# Examples:
#   - /var/log/mariadb-backup-encryption-error.log (system log directory)
#   - /home/backup/logs/backup-error.log (user directory)
#   - ./logs/backup-error.log (relative to script directory)
#
# PERMISSIONS:
#   - Log directory: 755 (drwxr-xr-x)
#   - Log file: 644 (-rw-r--r--)
#   - Ensure backup user has write access to log directory
ERROR_LOG=/var/log/mariadb-backup-encryption-error.log

# =============================================================================
# 🔒 ADDITIONAL SECURITY NOTES
# =============================================================================

# File Security
# - Set restrictive permissions on .env file: chmod 600 .env
# - Set appropriate permissions on log files: chmod 644 *.log
# - Consider using chown to set proper ownership
# - Regularly audit file permissions and access

# Environment Security
# - Use secure shell environments when handling sensitive data
# - Avoid displaying sensitive information in logs or console output
# - Consider using encrypted environment variables in production
# - Regularly rotate credentials and keys

# Backup Security
# - Test backup restoration procedures regularly
# - Verify backup integrity both before and after encryption
# - Implement proper access controls for backup files
# - Consider using immutable storage for critical backups

# Monitoring and Auditing
# - Monitor backup logs for unusual activity
# - Set up alerts for backup failures
# - Regularly review access logs for backup systems
# - Conduct periodic security audits of backup infrastructure

# Disaster Recovery
# - Store encryption keys in secure, offline locations
# - Document recovery procedures for different failure scenarios
# - Test recovery procedures regularly
# - Maintain offsite copies of critical backups